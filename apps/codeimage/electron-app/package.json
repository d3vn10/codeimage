{
  "name": "@codeimage/desktop",
  "version": "1.10.0",
  "private": true,
  "description": "Windows desktop wrapper for CodeImage",
  "main": "main.cjs",
  "scripts": {
    "package:win": "electron-builder --win nsis"
  },
  "build": {
    "appId": "dev.codeimage.desktop",
    "productName": "CodeImage",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "dist"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CodeImage-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
